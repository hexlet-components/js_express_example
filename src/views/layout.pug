doctype html
html(lang='ru')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title JS Express Example
    link(rel='stylesheet' href='/assets/main.css')
  body.bg-white.text-gray-900
    .mx-auto.max-w-3xl.px-4.py-8
      h1.mb-6.text-3xl.font-bold JS Express Example
      if flash && flash.length
        each message in flash
          div(class=`mb-4 rounded border px-4 py-3 ${alertClass(message.type)}`)= message.message
      block content
